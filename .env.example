# Shared Docker Compose configuration
POSTGRES_DB=tour_cmf
POSTGRES_USER=tour_cmf
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432

FRONTEND_PORT=3000
BACKEND_PORT=8000

# Browser-visible API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tour_cmf:change-me-before-production@db:5432/tour_cmf
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI LLM configuration (Google Gemini)
# Paste your Gemini API key below (starts with AIzaSy...):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Or configure via OpenAI-compatible endpoint:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=

